		function toggleJabatan(resetValue = true) {
			let jenis = $('#JENIS_JABATAN_SAPK').val();

			let jft = $('.jft-wrapper');
			let jfu = $('.jfu-wrapper');
			let jst = $('.jst-wrapper');

			hideAndDisable(jft, resetValue);
			hideAndDisable(jfu, resetValue);
			hideAndDisable(jst, resetValue);

			if (jenis === '2') {
				showAndRequire(jft);
			} else if (jenis === '4') {
				showAndRequire(jfu);
			} else if (jenis === '1') {
				showAndRequire(jst);
			}
		}


		// pertama kali load (edit mode)
		toggleJabatan(false);


